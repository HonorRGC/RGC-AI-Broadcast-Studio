OPENAI_API_KEY=
USE_OPENAI=true
OPENAI_MODEL=gpt-5.5

ELEVENLABS_API_KEY=
USE_ELEVENLABS=true
LEAD_BROADCASTER_NAME=Mike
COLOR_BROADCASTER_NAME=Jeff
PIT_BROADCASTER_NAME=Sarah
LEAD_VOICE_ID=
COLOR_VOICE_ID=
PIT_VOICE_ID=

# Optional league context
USE_LEAGUE_DRIVER_NOTES=false
LEAGUE_DRIVERS_CSV=league/drivers.csv
LEAGUE_SEASON_STATS_CSV=league/season.csv
LEAGUE_CAREER_STATS_CSV=league/career.csv
# Optional comma-separated stage end laps for league races, for example: 30,60
STAGE_END_LAPS=
# Optional league race package details for the opening call.
# Examples: LEAGUE_FUEL_PERCENT=65, LEAGUE_ENGINE_POWER_PERCENT=90, LEAGUE_TIRE_SETS=3
LEAGUE_FUEL_PERCENT=
LEAGUE_ENGINE_POWER_PERCENT=
LEAGUE_TIRE_SETS=

# Optional broadcast overlay title/sponsor
OVERLAY_EVENT_TITLE=RGC AI Broadcast
OVERLAY_RACE_SPONSOR=
OVERLAY_SERIES_NAME=
# side keeps the current left leaderboard; ticker scrolls across the top under the title.
OVERLAY_LEADERBOARD_STYLE=side
# 127.0.0.1 is this PC only. Use 0.0.0.0 to let a helper on the same network/VPN open Producer Assist.
OVERLAY_HOST=127.0.0.1
# Uses SIMRacingAppsServer for live 3D car renders and styled car numbers.
# If true, start SIMRacingAppsServer before starting the broadcast. If you are not using it, set false.
USE_SIM_RACING_APPS=true
# Release-track remote Producer Assist. Requires an RGC-hosted relay server.
REMOTE_PRODUCER_ENABLED=false
REMOTE_PRODUCER_RELAY_URL=
REMOTE_PRODUCER_SESSION_CODE=
REMOTE_PRODUCER_PIN=
OVERLAY_BRAND_GRAPHICS=/assets/rgc_motorsports.png,/assets/autism_awareness.png,/assets/keep_it_real.webp
CRANK_IT_UP_SPONSOR_GRAPHIC=/assets/rgc_motorsports.png
CRANK_IT_UP_ICON_GRAPHIC=/assets/crank_it_up.png

# Optional sponsor reads
USE_SPONSOR_READS=true
# Spoken sponsors are read in order: sponsor 1 first, then sponsor 2, then sponsor 3.
SPONSOR_READ_NAME=
SPONSOR_READ_NAME_2=
SPONSOR_READ_NAME_3=
# Cause / awareness setup. The name appears on overlays; the spoken read is what the broadcaster says.
SPONSOR_READ_CAUSE_NAME=
SPONSOR_READ_CAUSE_LOGO=
SPONSOR_READ_CAUSE_READ=
# Optional exact sponsor script. Supports {sponsor}, {cause}, and {cause_read}. If blank, the app writes one automatically.
SPONSOR_READ_MESSAGE=

# Optional RGC Anthem ceremony during qualifying
USE_NATIONAL_ANTHEM=false
NATIONAL_ANTHEM_AUDIO=
NATIONAL_ANTHEM_GRAPHICS=

# Optional music beds. Use semicolons between practice songs.
STUDIO_VOLUME=65
PRACTICE_MUSIC_PLAYLIST=
CAUTION_REPLAY_AUDIO=
CAUTION_PRESENTATION_GRAPHICS=
POST_RACE_INTERVIEWS_ENABLED=false
# Hosted-race admin buttons in Producer Assist. Keep false unless broadcaster PC is an iRacing session admin.
RACE_ADMIN_MODE=false
# clipboard is broadcast-safe and copies the command for manual use.
# open_chat copies the command and opens iRacing text chat for quick Ctrl+V/Enter.
# ui_paste is testing-only and may show iRacing chat/window on the broadcast.
RACE_ADMIN_SEND_MODE=clipboard

# Future Discord interview bot setup. Leave blank until Discord integration is enabled.
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_BOOTH_CHANNEL_ID=
DISCORD_WAITING_CHANNEL_ID=
DISCORD_INTERVIEW_CHANNEL_ID=

# Optional Discord race report. Create a Discord channel webhook and paste it here.
# This posts a post-race recap after the finishing order is stable.
DISCORD_RACE_REPORT_ENABLED=false
DISCORD_RACE_REPORT_WEBHOOK_URL=
DISCORD_RACE_REPORT_USE_OPENAI=true
