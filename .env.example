OPENAI_API_KEY=
USE_OPENAI=true
OPENAI_MODEL=gpt-5.5

ELEVENLABS_API_KEY=
USE_ELEVENLABS=true
LEAD_VOICE_ID=
COLOR_VOICE_ID=
PIT_VOICE_ID=

# Optional league context
USE_LEAGUE_DRIVER_NOTES=false
LEAGUE_DRIVERS_CSV=league/drivers.csv
LEAGUE_SEASON_STATS_CSV=league/season.csv
LEAGUE_CAREER_STATS_CSV=league/career.csv
# Optional comma-separated stage end laps for league races, for example: 30,60
STAGE_END_LAPS=

# Optional broadcast overlay title/sponsor
OVERLAY_EVENT_TITLE=RGC AI Broadcast
OVERLAY_RACE_SPONSOR=
OVERLAY_SERIES_NAME=
# side keeps the current left leaderboard; ticker scrolls across the top under the title.
OVERLAY_LEADERBOARD_STYLE=side
OVERLAY_BRAND_GRAPHICS=/assets/rgc_motorsports.png,/assets/autism_awareness.png,/assets/keep_it_real.webp
CRANK_IT_UP_SPONSOR_GRAPHIC=/assets/rgc_motorsports.png
CRANK_IT_UP_ICON_GRAPHIC=/assets/crank_it_up.png

# Optional sponsor reads
USE_SPONSOR_READS=true
# Spoken sponsor name used in sponsor reads and sponsor logo popups.
SPONSOR_READ_NAME=
# Cause or awareness message, for example Autism Awareness.
SPONSOR_READ_CAUSE=
# Optional exact sponsor script. Supports {sponsor} and {cause}. If blank, the app writes one automatically.
SPONSOR_READ_MESSAGE=

# Optional RGC Anthem ceremony during qualifying
USE_NATIONAL_ANTHEM=false
NATIONAL_ANTHEM_AUDIO=
NATIONAL_ANTHEM_GRAPHICS=

# Optional music beds. Use semicolons between practice songs.
STUDIO_VOLUME=65
PRACTICE_MUSIC_PLAYLIST=
CAUTION_REPLAY_AUDIO=
CAUTION_PRESENTATION_GRAPHICS=
POST_RACE_INTERVIEWS_ENABLED=false
